  "mechanicsThresholds": {
    "version": "1.0.0",
    "issue": "SCA-1861",
    "strokeType": "forehand_drive",
    "scoredKeyFrame": "contact",
    "keyFrameRule": "Frame of peak right-wrist speed (wrist displacement between measurable frames, normalized by torso length) within the clip \u2014 the textbook proxy for ball contact in a racquet swing. Ties resolve to the lowest frame index. PoseFrame carries no phase labels yet (segmentation is a later milestone); when segmentation lands, an annotated contact window can override this kinematic detector.",
    "note": "These are GENERIC ideal bands for a sound recreational-to-intermediate forehand drive, expressed as scale-invariant joint angles and torso-normalized ratios (single-camera 2D). They are coaching reference ranges, not pro-derived pose tracks (rights-safe Option C, docs/RIGHTS_PLAN.md). The same `ranges` are consumed by both ComparisonEngine (SCA-1824) and MechanicsScoringEngine (SCA-1861) so the two never drift.",
    "categories": [
      {
        "feature": "right_elbow_angle_deg",
        "label": "elbow extension",
        "unit": "degrees",
        "contactIdeal": {
          "idealMin": 150,
          "idealMax": 175
        },
        "rationale": "Near-full arm extension at contact transfers racquet-head speed efficiently; coaching consensus places forehand-drive contact elbow extension in the ~150\u2013175\u00b0 band (a slightly soft elbow, not locked).",
        "source": {
          "title": "USA Pickleball \u2014 Official Rulebook & Skill Resources / IFP technique guidance",
          "publisher": "USA Pickleball Association",
          "url": "https://usapickleball.org/",
          "type": "governing-body coaching guidance",
          "accessed": "2026-06-05"
        }
      },
      {
        "feature": "arm_extension_rel_torso",
        "label": "arm extension (reach)",
        "unit": "ratio (shoulder\u2192wrist / torso length)",
        "contactIdeal": {
          "idealMin": 0.95,
          "idealMax": 1.35
        },
        "rationale": "Contact should occur out in front with the arm reaching roughly one torso-length from the shoulder; under-reach indicates a cramped, late contact. Threshold derived from the idealized exemplar skeleton geometry and bounded by anthropometric arm:torso proportion.",
        "source": {
          "title": "Plagenhoef, Stanley \u2014 Patterns of Human Motion: A Cinematographic Analysis",
          "publisher": "Prentice-Hall",
          "type": "biomechanics reference (segment proportions)",
          "year": 1971
        }
      },
      {
        "feature": "wrist_height_rel_torso",
        "label": "contact height",
        "unit": "ratio (wrist.y \u2212 shoulder.y / torso length; + = above shoulder)",
        "contactIdeal": {
          "idealMin": -0.45,
          "idealMax": 0.1
        },
        "rationale": "A forehand DRIVE contacts the ball roughly between waist and shoulder height \u2014 below the shoulder line but not at the ankles. Values are signed relative to the shoulder and normalized by torso length so they are body-scale invariant.",
        "source": {
          "title": "USA Pickleball \u2014 Groundstroke / drive technique guidance",
          "publisher": "USA Pickleball Association",
          "url": "https://usapickleball.org/",
          "type": "governing-body coaching guidance",
          "accessed": "2026-06-05"
        }
      }
    ]
  },
